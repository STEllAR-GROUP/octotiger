def buildbadge = addEmbeddableBadgeConfiguration(id: "nodelevel", subject: "CPU / GPU Node-Level Tests", status: "skipped")

pipeline {
    agent any

    options {
        buildDiscarder(
            logRotator(
                daysToKeepStr: "28",
                numToKeepStr: "100",
                artifactDaysToKeepStr: "28",
                artifactNumToKeepStr: "100"
            )
        )
        disableConcurrentBuilds()
    }
    environment {
        GITHUB_TOKEN = credentials('GITHUB_TOKEN_OCTOTIGER')
        MAINTAINER_MAIL = credentials('OCTOTIGER_MAINTAINER_EMAIL')
    }
    stages {
        stage('checkout') {
            steps {
                script {
                    buildbadge.setStatus('running')
                }
                dir('octotiger') {
                    checkout scm
                    sh '''
                        git submodule sync --recursive
                        git submodule update --init --recursive
                    '''
                }
            }
        }
        stage('build') {
            matrix {
                axes {
                    axis {
                        name 'build_spec'
                        // List of "tuples" containing the test run infomation
                        // Format: 
                        // spack octotiger spec ; run name ; required modules ; SLURM partition for this test ; additional flags for spack dev-build
                        values ' +cuda +kokkos cuda_arch=70  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system  %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-cuda-with-kokkos;gcc/11 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' +cuda +kokkos cuda_arch=70 griddim=16  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-cuda-with-kokkos-griddim16;gcc/11 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' ~cuda +kokkos  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^kokkos@5.2.2 std=20 ~cuda %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-without-cuda-with-kokkos;gcc/11 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' +cuda ~kokkos cuda_arch=70 %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran %gcc@13.2.0 ;with-CC-with-cuda-without-kokkos;gcc/11 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' ~cuda ~kokkos  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-without-cuda-without-kokkos;gcc/11 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' +cuda +kokkos cuda_arch=70  %clang@20 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %clang@20 ^cppuddle %clang@20 ^hpx-kokkos %clang@20 ^kokkos@5.2.2 std=20 ~shared %clang@20 ^silo~mpi~fortran ;with-CC-clang-with-cuda-with-kokkos;llvm/20 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' +cuda +kokkos cuda_arch=70 griddim=16  %clang@20 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %clang@20 ^cppuddle %clang@20 ^hpx-kokkos %clang@20 ^kokkos@5.2.2 std=20 ~shared %clang@20 ^silo~mpi~fortran ;with-CC-clang-with-cuda-with-kokkos-griddim16;llvm/20 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' ~cuda +kokkos  %clang@20 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %clang@20 ^cppuddle %clang@20 ^hpx-kokkos %clang@20 ^kokkos@5.2.2 std=20 %clang@20 ^silo~mpi~fortran ;with-CC-clang-without-cuda-with-kokkos;llvm/20 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' +cuda ~kokkos cuda_arch=70  %clang@20 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %clang@20 ^cppuddle %clang@20 ^silo~mpi~fortran ;with-CC-clang-with-cuda-without-kokkos;llvm/20 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' ~cuda ~kokkos  %clang@20 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %clang@20 ^cppuddle %clang@20 ^silo~mpi~fortran ;with-CC-clang-without-cuda-without-kokkos;llvm/20 cuda/12;cuda-V100 --exclusive;--fresh',\
                               ' +rocm +kokkos amdgpu_target=gfx908 %rocmcc@6.4.1 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 amdgpu_target=gfx908 %rocmcc@6.4.1 ^kokkos@5.2.2 std=20 amdgpu_target=gfx908 %rocmcc@6.4.1 ^hip@6.4.1 ^hsa-rocr-dev@6.4.1 ^llvm-amdgpu@6.4.1 ^cppuddle %rocmcc@6.4.1 ^hpx-kokkos %rocmcc@6.4.1 ^silo~mpi~fortran %gcc@13.2.0 ;with-CC-clang-with-hip-with-kokkos;rocm/6.4.1;jenkins-amdgpu --exclusive -c 16 --threads-per-core=1;--fresh --dirty',\
                               ' +kokkos simd_extension=SCALAR simd_library=STD  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-std-with-scalar;gcc/11;medusa --exclusive;--fresh',\
                               ' +kokkos simd_extension=AVX512 simd_library=STD  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-std-with-avx512;gcc/11;medusa --exclusive;--fresh',\
                               ' +kokkos +kokkos_hpx_kernels multipole_host_tasks=16 monopole_host_tasks=4 hydro_host_tasks=4 simd_extension=AVX512 simd_library=STD  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-std-with-avx512-with-hpx-kokkos-kernels;gcc/11;medusa --exclusive;--fresh',\
                               ' +kokkos simd_extension=SCALAR simd_library=KOKKOS  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-kokkos-with-scalar;gcc/11;medusa --exclusive;--fresh',\
                               ' +kokkos simd_extension=AVX512 simd_library=KOKKOS  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-kokkos-with-avx512;gcc/11;medusa --exclusive;--fresh',\
                               ' +kokkos +kokkos_hpx_kernels multipole_host_tasks=16 monopole_host_tasks=4 hydro_host_tasks=4 simd_extension=AVX512 simd_library=KOKKOS  %gcc@13.2.0 ^hpx@2.0.0rc1 cxxstd=20 max_cpu_count=128 malloc=system %gcc@13.2.0 ^kokkos@5.2.2 std=20 %gcc@13.2.0 ^hpx-kokkos %gcc@13.2.0 ^cppuddle %gcc@13.2.0 ^silo~mpi~fortran ;with-CC-with-kokkos-with-avx512-with-hpx-kokkos-kernels;gcc/11;medusa --exclusive;--fresh',\
                               ' ~cuda ~rocm +kokkos +sycl  %gcc@13.2.0 ^kokkos@5.2.2 std=20 use_unsupported_sycl_arch=70 ^hpx@2.0.0rc1 cxxstd=20 sycl_target_arch=70 ^silo~mpi~fortran;with-CC-with-kokkos-with-sycl;gcc/11 cuda/12;cuda-V100 -w diablo -c 10 --exclusive;--fresh'
                    }
                }
                stages {
                    stage('init') {
                        steps {
                            dir('octotiger') {
                                sh '''
                                # Unpack tuples:
                                spack_spec=$(echo "${build_spec}" | cut -d ";" -f 1)
                                build_description=$(echo "${build_spec}" | cut -d ";" -f 2)
                                github_token=$(echo ${GITHUB_TOKEN} | cut -f2 -d':')
                                curl --verbose\
                                    --request POST \
                                    --url "https://api.github.com/repos/STEllAR-GROUP/octotiger/statuses/$GIT_COMMIT" \
                                    --header "Content-Type: application/json" \
                                    --header "authorization: Bearer ${github_token}" \
                                    --data "{
                                        \\"state\\": \\"pending\\",
                                        \\"context\\": \\"jenkins-${build_description}\\",
                                        \\"description\\": \\"Jenkins CI Job: ${build_description}\\",
                                        \\"target_url\\": \\"https://rostam.cct.lsu.edu/jenkins/job/Octo-Tiger%20Node-Level/job/$JOB_BASE_NAME/$BUILD_NUMBER/console\\"
                                    }"
                                '''
                            }
                        }
                    }
                    stage('build-and-test') {
                        steps {
                            dir('octotiger') {
                                sh '''#!/bin/bash -l
                                set -e -o pipefail
                                # Unpack tuples:
                                spack_spec=$(echo "${build_spec}" | cut -d ";" -f 1)
                                build_description=$(echo "${build_spec}" | cut -d ";" -f 2)
                                required_modules=$(echo "${build_spec}" | cut -d ";" -f 3)
                                slurm_partition=$(echo "${build_spec}" | cut -d ";" -f 4)
                                extra_spack_flags=$(echo "${build_spec}" | cut -d ";" -f 5)
                                # Exercise multiple HPX workers while preserving HIP/SYCL requests.
                                cpu_options=()
                                case " ${slurm_partition} " in
                                    *" -c "*|*" --cpus-per-task="*|*" --cpus-per-task "*) ;;
                                    *) cpu_options=(--cpus-per-task=4) ;;
                                esac
                                # Rostam requires an explicit GPU request even with --exclusive.
                                # https://wiki.rostam.cct.lsu.edu/en/slurm/gpu
                                gpu_options=()
                                case " ${spack_spec} " in
                                    *" +cuda "*|*" +sycl "*) gpu_options=(--gres=gpu:1) ;;
                                esac
                                export spack_spec required_modules extra_spack_flags
                                # Setup src to test; each matrix entry needs its own output files.
                                cd ..
                                rm -rf "octotiger-${build_description}"
                                cp -r octotiger "octotiger-${build_description}"
                                cd "octotiger-${build_description}"
                                srun -p ${slurm_partition} "${cpu_options[@]}" "${gpu_options[@]}" -N 1 -n 1 --time=900 bash -ls <<'BUILD_SCRIPT'
set -e -o pipefail
trap 'build_status=$?; if [[ -f install-time-test-log.txt ]]; then cat install-time-test-log.txt; fi; exit "$build_status"' EXIT
echo "Slurm allocation: job=${SLURM_JOB_ID:-unknown} step=${SLURM_STEP_ID:-unknown} host=$(hostname)"
module load ${required_modules}
module list
# Initialized by the separate, manual Spack setup pipeline.
source "${HOME}/jenkins_spack_install/share/spack/setup-env.sh"
spack --version
export TMPDIR=/work/jenkins/spack_tmp
if [[ " ${required_modules} " == *" rocm/"* ]]; then
    command -v hipcc
fi
flock --verbose -x -w 600 /work/jenkins/jenkins-spack-config.lock spack external find
flock --verbose -x -w 600 /work/jenkins/jenkins-spack-config.lock spack external find cmake git libffi python
flock --verbose -x -w 600 /work/jenkins/jenkins-spack-config.lock spack external find cuda hip llvm-amdgpu hsa-rocr-dev
flock --verbose -x -w 600 /work/jenkins/jenkins-spack-config.lock spack compiler find
spack compiler list
# Respect the allocation, including the 16-CPU HIP and 10-CPU SYCL entries.
build_jobs=${SLURM_CPUS_PER_TASK:-${SLURM_CPUS_ON_NODE:-1}}
case "${build_jobs}" in
    ''|*[!0-9]*) echo "Invalid allocated CPU count: ${build_jobs}" >&2; exit 1 ;;
esac
available_cpus=$(nproc)
if (( build_jobs > available_cpus )); then build_jobs=${available_cpus}; fi
if (( build_jobs > 32 )); then build_jobs=32; fi
if (( build_jobs < 1 )); then echo "No allocated CPUs" >&2; exit 1; fi
export AMD_DIRECT_DISPATCH=0
export HIP_VISIBLE_DEVICES=1
export HPX_NUM_WORKER_THREADS=${build_jobs}
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
# Cases write shared diagnostic filenames within a matrix entry.
export CTEST_PARALLEL_LEVEL=1
# Record allocation visibility without overriding scheduler or runtime filters.
for octotiger_gpu_variable in SLURM_JOB_GPUS SLURM_STEP_GPUS CUDA_VISIBLE_DEVICES HIP_VISIBLE_DEVICES ROCR_VISIBLE_DEVICES KOKKOS_VISIBLE_DEVICES SYCL_DEVICE_FILTER ONEAPI_DEVICE_SELECTOR; do
    if [[ -v "${octotiger_gpu_variable}" ]]; then
        echo "GPU environment: ${octotiger_gpu_variable}=${!octotiger_gpu_variable}"
    else
        echo "GPU environment: ${octotiger_gpu_variable}=<unset>"
    fi
done
if [[ " ${spack_spec} " == *" +cuda "* || " ${spack_spec} " == *" +sycl "* ]]; then
    if command -v nvidia-smi >/dev/null 2>&1; then
        echo "NVIDIA GPU inventory (15-second limit, 5-second termination grace):"
        if ! timeout --kill-after=5s 15s nvidia-smi -L; then
            echo "GPU inventory failed or timed out; continuing to the tests."
        fi
    else
        echo "GPU inventory unavailable: nvidia-smi is not installed; continuing to the tests."
    fi
fi
# PowerTiger supplies the pinned, patched source stack and a GCC bootstrap.
powertiger_flags=()
if [[ " ${extra_spack_flags} " == *" --dirty "* ]]; then
    powertiger_flags+=(--dirty)
fi
python3 .jenkins/lsu/hpx2rc/run-powertiger.py \
    --source "${PWD}" --spec "${spack_spec}" --jobs "${build_jobs}" "${powertiger_flags[@]}"
BUILD_SCRIPT
                                '''
                            }
                        }
                    }
                }
                post {
                    success {
                        sh '''
                        build_description=$(echo "${build_spec}" | cut -d ";" -f 2)
                        github_token=$(echo ${GITHUB_TOKEN} | cut -f2 -d':')
                        curl --verbose\
                            --request POST \
                            --url "https://api.github.com/repos/STEllAR-GROUP/octotiger/statuses/$GIT_COMMIT" \
                            --header "Content-Type: application/json" \
                            --header "authorization: Bearer ${github_token}" \
                            --data "{
                                \\"state\\": \\"success\\",
                                \\"context\\": \\"jenkins-${build_description}\\",
                                \\"description\\": \\"Jenkins CI Job: ${build_description}\\",
                                \\"target_url\\": \\"https://rostam.cct.lsu.edu/jenkins/job/Octo-Tiger%20Node-Level/job/$JOB_BASE_NAME/$BUILD_NUMBER/console\\"
                            }"
                        '''
                    }
                    failure {
                        sh '''
                        build_description=$(echo "${build_spec}" | cut -d ";" -f 2)
                        github_token=$(echo ${GITHUB_TOKEN} | cut -f2 -d':')
                        curl --verbose\
                            --request POST \
                            --url "https://api.github.com/repos/STEllAR-GROUP/octotiger/statuses/$GIT_COMMIT" \
                            --header "Content-Type: application/json" \
                            --header "authorization: Bearer ${github_token}" \
                            --data "{
                                \\"state\\": \\"failure\\",
                                \\"context\\": \\"jenkins-${build_description}\\",
                                \\"description\\": \\"Jenkins CI Job: ${build_description}\\",
                                \\"target_url\\": \\"https://rostam.cct.lsu.edu/jenkins/job/Octo-Tiger%20Node-Level/job/$JOB_BASE_NAME/$BUILD_NUMBER/console\\"
                            }"
                        '''
                    }
                    aborted {
                        sh '''
                        build_description=$(echo "${build_spec}" | cut -d ";" -f 2)
                        github_token=$(echo ${GITHUB_TOKEN} | cut -f2 -d':')
                        curl --verbose\
                            --request POST \
                            --url "https://api.github.com/repos/STEllAR-GROUP/octotiger/statuses/$GIT_COMMIT" \
                            --header "Content-Type: application/json" \
                            --header "authorization: Bearer ${github_token}" \
                            --data "{
                                \\"state\\": \\"error\\",
                                \\"context\\": \\"jenkins-${build_description}\\",
                                \\"description\\": \\"Jenkins CI Job: ${build_description}\\",
                                \\"target_url\\": \\"https://rostam.cct.lsu.edu/jenkins/job/Octo-Tiger%20Node-Level/job/$JOB_BASE_NAME/$BUILD_NUMBER/console\\"
                            }"
                        '''
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'octotiger-*/install-time-test-log.txt,octotiger-*/spack-build-out.txt,octotiger-*/spack-build/Testing/Temporary/*.log,octotiger-*/spack-build-*/Testing/Temporary/*.log,octotiger-*/spack-build/Testing/Temporary/*.log.tmp,octotiger-*/spack-build-*/Testing/Temporary/*.log.tmp,octotiger-*/spack-build/Testing/Temporary/CTestCheckpoint.txt,octotiger-*/spack-build-*/Testing/Temporary/CTestCheckpoint.txt,octotiger-*/.jenkins-spack-overlay/manifest.json,octotiger-*/.jenkins-powertiger-provenance.json,octotiger-*/.jenkins-spack-overlay/config/*.yaml,octotiger-*/spack-build/test_problems/**/*_log.txt,octotiger-*/.jenkins-spack-overlay/repo/packages/**/*.py,octotiger-*/.jenkins-spack-overlay/repo/packages/**/*.patch', allowEmptyArchive: true
        }
        success {
            script {
                buildbadge.setStatus('success')
            }
        }
        failure {
            script {
                buildbadge.setStatus('failing')
            }
            sh '''
                echo "Build failed! Pipeline ${JOB_BASE_NAME} with build ID ${BUILD_NUMBER} using GIT commit ${GIT_COMMIT}" | mail -s "Jenkins Octo-Tiger Node-Level Tests: Build ${JOB_BASE_NAME}/${BUILD_NUMBER} failed" "${MAINTAINER_MAIL}"
            '''
        }
        aborted {
            script {
                buildbadge.setStatus('aborted')
            }
            sh '''
                echo "Build aborted on pipeline ${JOB_BASE_NAME} with build ID ${BUILD_NUMBER} using GIT commit ${GIT_COMMIT}" | mail -s "Jenkins Octo-Tiger Node-Level Tests: Build ${JOB_BASE_NAME}/${BUILD_NUMBER} aborted" "${MAINTAINER_MAIL}"
            '''
        }
    }
}
